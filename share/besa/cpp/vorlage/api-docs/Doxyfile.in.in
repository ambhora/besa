# --------------------------------------------------------------------------------------------------
# Base Doxygen configuration used by api-docs/conf.py.
#
# CMake configures this template into <build>/api-docs/Doxyfile so Clang-assisted parsing can use
# the compilation database as parser input. conf.py then runs one Doxygen pass per declared BESA API
# profile, stages only API-classified roots selected by that profile, and merges the XML inventories
# before Breathe/Exhale sees them. The current build therefore does not determine which supported
# declarations appear in the reference. Repository paths never leak into the rendered file hierarchy.
# --------------------------------------------------------------------------------------------------

PROJECT_NAME           = "vorlage"
RECURSIVE              = YES

# Document the complete API represented by each profile, including declarations which do not yet
# carry comments. conf.py forms the union; implementation and executable trees never enter Doxygen.
EXTRACT_ALL            = YES

# Sphinx/Breathe/Exhale is the presentation layer. Doxygen is used only as the C/C++ parser and XML
# extractor, so standalone Doxygen HTML is deliberately disabled.
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
HAVE_DOT                = YES

# Doxygen must be built with libclang support (-Duse_libclang=ON) for these options.
CLANG_ASSISTED_PARSING = YES
CLANG_ADD_INC_PATHS    = YES
CLANG_DATABASE_PATH    = "@CMAKE_BINARY_DIR@"

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
