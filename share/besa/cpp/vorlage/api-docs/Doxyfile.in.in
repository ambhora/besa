# --------------------------------------------------------------------------------------------------
# Base Doxygen configuration used by api-docs/conf.py.
#
# CMake configures this template into <build>/api-docs/Doxyfile so Clang-assisted parsing can use
# the compile_commands.json produced by the exact checkout/build tree. conf.py then copies that
# configured base into the checkout-specific Doxygen work tree and appends PROJECT_NUMBER,
# OUTPUT_DIRECTORY, INPUT, STRIP_FROM_PATH, and STRIP_FROM_INC_PATH values before running Doxygen.
# INPUT starts from a synthetic public-header tree mirroring the contents installed below include/
# and adds developer-facing headers from test/base. Repository paths such as src/cpp/include and
# test/base/cpp/include never leak into the rendered file hierarchy.
# --------------------------------------------------------------------------------------------------

PROJECT_NAME           = "vorlage"
RECURSIVE              = YES

# Document the complete selected API, including declarations which do not yet carry comments. conf.py
# stages public headers and test/base developer headers into INPUT, while implementation and executable
# trees never enter Doxygen.
EXTRACT_ALL            = YES

# Sphinx/Breathe/Exhale is the presentation layer. Doxygen is used only as the C/C++ parser and XML
# extractor, so standalone Doxygen HTML is deliberately disabled.
GENERATE_XML           = YES
XML_OUTPUT             = xml
GENERATE_HTML          = NO
GENERATE_LATEX         = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
HAVE_DOT                = YES

# Use the compilation database generated by this exact CMake build. The Doxygen executable
# must itself have been built with libclang support for these options to be available.
CLANG_ASSISTED_PARSING = YES
CLANG_ADD_INC_PATHS    = YES
CLANG_DATABASE_PATH    = "@CMAKE_BINARY_DIR@"
