set(MANIFEST_PATH "${BINARY_DIR}/besa/manifest.json")
if(NOT EXISTS "${MANIFEST_PATH}")
  message(FATAL_ERROR "missing ${MANIFEST_PATH}")
endif()
file(READ "${MANIFEST_PATH}" MANIFEST_JSON)
string(JSON MANIFEST_PROJECT GET "${MANIFEST_JSON}" project)
string(JSON UNIT_COUNT LENGTH "${MANIFEST_JSON}" units)
if(NOT MANIFEST_PROJECT STREQUAL "basic" OR NOT UNIT_COUNT EQUAL 2)
  message(FATAL_ERROR "unexpected manifest:\n${MANIFEST_JSON}")
endif()
string(JSON FIRST_UNIT_TYPE GET "${MANIFEST_JSON}" units 0 type)
string(JSON SECOND_UNIT_TYPE GET "${MANIFEST_JSON}" units 1 type)
if(NOT FIRST_UNIT_TYPE STREQUAL "cpp" OR NOT SECOND_UNIT_TYPE STREQUAL "bin")
  message(FATAL_ERROR "expected cpp and bin units:\n${MANIFEST_JSON}")
endif()
string(JSON FIRST_UNIT_LANGUAGE GET "${MANIFEST_JSON}" units 0 language)
string(JSON FIRST_UNIT_PARSER_LANGUAGE GET "${MANIFEST_JSON}" units 0 parse language)
if(NOT FIRST_UNIT_LANGUAGE STREQUAL "cpp" OR NOT FIRST_UNIT_PARSER_LANGUAGE STREQUAL "cpp")
  message(FATAL_ERROR "cpp unit did not preserve semantic/parser language:\n${MANIFEST_JSON}")
endif()
string(JSON HEADER_COUNT LENGTH "${MANIFEST_JSON}" units 0 headers)
string(JSON SOURCE_COUNT LENGTH "${MANIFEST_JSON}" units 0 sources)
if(NOT HEADER_COUNT EQUAL 1 OR NOT SOURCE_COUNT EQUAL 1)
  message(FATAL_ERROR "cpp unit did not lower to include/lib roots:\n${MANIFEST_JSON}")
endif()
