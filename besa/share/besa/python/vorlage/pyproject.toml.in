[project]
name = "vorlage"
dynamic = ["version"]
description = "A BESA Python project"
readme = "readme.md"
requires-python = ">=3.11"
license = "Apache-2.0"
authors = [
  { name = "Jayesh Badwaik", email = "j.badwaik@fz-juelich.de" },
]
dependencies = []

[project.scripts]
vorlage = "vorlage.cli:main"

[tool.hatch.version]
path = "src/vorlage/metadata.py"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/vorlage"]

[dependency-groups]
test = ["pytest", "build"]

[tool.pytest.ini_options]
pythonpath = ["src"]
testpaths = ["test"]

[tool.hatch.envs.tests]
dependencies = [
  "pytest",
]

[tool.hatch.envs.tests.scripts]
test = "pytest {args:test}"
